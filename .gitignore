# VS build folders
/.vs/
/build/
/builds/
/debug/
/release/
/installer/.vs/
/installer/bin/
/installer/obj/
/CMakeLists.txt.user
/.qtcreator

# VS generated files
*.obj
*.pdb
*.res
*.exe

# SW build dir and generated files
.sw
/*.lnk

# CMake user presets (machine-local, may contain signing credentials)
CMakeUserPresets.json

# Generated by CMake from .clangd.in (contains a machine-specific NDK path)
/.clangd

# Claude Code working data: project memory, skills and session state. Holds machine
# addresses and credentials of the build fleet, must never reach the public repository.
/.claude/
