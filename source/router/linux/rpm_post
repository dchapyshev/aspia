# Register the service via the application itself (account and sandboxing are provisioned there,
# shared with the command line). --install is a no-op when no configuration exists yet, so a clean
# install does not fail; on an upgrade it refreshes an already-configured service. %post runs on both
# install ($1=1) and upgrade ($1=2).
/usr/bin/aspia_router --install || true

# %pre stopped the service before the files were replaced, so an upgrade starts it again. A first
# installation leaves it stopped: there is no configuration yet and the administrator starts the
# service once there is one. Argument 2 is an upgrade, 1 a first install. This is what the installer
# on Windows does.
if [ "$1" -ge 2 ] && [ -d /run/systemd/system ]; then
    systemctl start aspia-router.service >/dev/null 2>&1 || true
fi
