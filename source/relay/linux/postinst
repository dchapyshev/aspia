#!/bin/sh
set -e

# Register the service via the application itself (account and sandboxing are provisioned there,
# shared with the command line). --install is a no-op when no configuration exists yet, so a clean
# install does not fail; on an upgrade it refreshes an already-configured service. A failure here
# must not abort the installation - the files are in place and the service can be registered by
# hand afterwards.
if [ "$1" = "configure" ]; then
    /usr/bin/aspia_relay --install || true
fi

# preinst stopped the service before the files were replaced, so an upgrade starts it again. A
# first installation leaves it stopped: there is no configuration yet and the administrator starts
# the service once there is one. Only an upgrade has a version configured before it, and $2 holds
# it. This is what the installer on Windows does.
if [ "$1" = "configure" ] && [ -n "$2" ] && [ -d /run/systemd/system ]; then
    systemctl start aspia-relay.service >/dev/null 2>&1 || true
fi
